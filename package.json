{
 "name": "kinetix-pro",
 "version": "1.0.0",
 "description": "KINETIX PRO — Entrenamiento, Nutrición y Composición Corporal (offline)",
 "main": "electron/main.js",
 "author": "KINETIX <kinetix@example.com>",
 "license": "MIT",
 "scripts": {
  "serve": "npx http-server www -p 8080 -c-1",
  "start": "electron .",
  "dist:win": "electron-builder --win",
  "dist:mac": "electron-builder --mac",
  "dist:linux": "electron-builder --linux",
  "android:add": "cap add android",
  "android:perms": "node scripts/patch-android.js",
  "android:icons": "capacitor-assets generate --android",
  "android:sync": "cap sync android",
  "android:open": "cap open android",
  "android:setup": "cap add android && node scripts/patch-android.js && capacitor-assets generate --android && cap sync android",
  "android:apk": "cap sync android && cd android && ./gradlew assembleDebug"
 },
 "dependencies": {
  "@capacitor/android": "^6.0.0",
  "@capacitor/core": "^6.0.0",
  "@capacitor/filesystem": "^6.0.0",
  "@capacitor/share": "^6.0.0"
 },
 "devDependencies": {
  "@capacitor/assets": "^3.0.5",
  "@capacitor/cli": "^6.0.0",
  "electron": "^31.0.0",
  "electron-builder": "^24.13.3"
 },
 "build": {
  "appId": "com.kinetix.pro",
  "productName": "KINETIX PRO",
  "files": [
   "electron/**/*",
   "www/**/*",
   "package.json"
  ],
  "directories": {
   "output": "dist",
   "buildResources": "build"
  },
  "win": {
   "target": [
    {
     "target": "nsis",
     "arch": [
      "x64"
     ]
    },
    {
     "target": "portable",
     "arch": [
      "x64"
     ]
    }
   ],
   "icon": "build/icon.ico",
   "signAndEditExecutable": false
  },
  "mac": {
   "target": "dmg",
   "category": "public.app-category.healthcare-fitness",
   "icon": "build/icon.png"
  },
  "linux": {
   "target": [
    "AppImage",
    "deb"
   ],
   "category": "Health",
   "icon": "build/icon.png"
  },
  "nsis": {
   "oneClick": false,
   "allowToChangeInstallationDirectory": true,
   "createDesktopShortcut": true,
   "shortcutName": "KINETIX PRO",
   "artifactName": "KINETIX-PRO-Instalador-${version}.${ext}"
  },
  "portable": {
   "artifactName": "KINETIX-PRO-Portable-${version}.${ext}"
  }
 }
}
